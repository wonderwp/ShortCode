{
  "name": "wonderwp/shortcode",
  "description": "WonderWp ShortCode Component",
  "type": "library",
  "keywords": [
    "service",
    "shortcode",
    "WonderWp",
    "WordPress"
  ],
  "homepage": "https://github.com/wonderwp/ShortCode",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "wonderwp/service": "dev-feature/php_8"
  },
  "autoload": {
    "psr-4": {
      "WonderWp\\Component\\Shortcode\\": "src"
    },
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "minimum-stability": "dev",
  "autoload-dev": {
    "psr-4": {
      "WonderWp\\Component\\Shortcode\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  }
}
